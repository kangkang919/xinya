generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  isVerified    Boolean  @default(false)
  theme         String   @default("spring")
  onboardDone   Boolean  @default(false)
  openTimes     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  entries        Entry[]
  tags           Tag[]
  shares         Share[]
  insightReports InsightReport[]
  aiInsights     AiInsight[]
  growthLogs     GrowthLog[]
  emailTokens    EmailToken[]
  settings       UserSetting?
  quizRecords    QuizRecord[]
  reviewCallLogs ReviewCallLog[]

  // ===== 豆苗学习助手模块（删除豆苗时移除以下 4 个关系字段）=====
  assistantProfile  AssistantProfile?
  assistantMessages AssistantMessage[]
  assistantMemories AssistantMemory[]
  assistantUsages   AssistantUsage[]
}

model Entry {
  id          String    @id @default(cuid())
  userId      String
  title       String
  content     String
  keyPoints   String?
  mood        String?
  recordTime  DateTime  @default(now())
  isTop       Boolean   @default(false)
  isFavorite  Boolean   @default(false)
  isDraft     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags        Tag[]     @relation("EntryTags")
  quizQuestions QuizQuestion[]
  sortOrders  EntryTagSort[]
  linksFrom   EntryLink[] @relation("EntryLinkFrom")
  linksTo     EntryLink[] @relation("EntryLinkTo")

  @@index([userId, recordTime(sort: Desc)])
  @@index([userId, isTop])
  @@index([userId, isFavorite])
  @@index([userId, isDraft])
}

model Tag {
  id        String   @id @default(cuid())
  userId    String
  name      String
  parentId  String?
  isDefault Boolean  @default(false)
  // 子标签在父标签下的自定义排序：0=未排序（按名称），负数=已手动排序（-1 最靠前）
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries  Entry[]  @relation("EntryTags")
  parent   Tag?     @relation("TagHierarchy", fields: [parentId], references: [id])
  children Tag[]    @relation("TagHierarchy")
  entrySortOrders EntryTagSort[]

  @@unique([userId, name])
  @@index([userId])
  @@index([parentId])
}

// 心得在标签视图下的自定义排序（每个标签独立排序）
// sortOrder = 0 表示未排序（按 recordTime 倒序，排在最前）
// sortOrder 为负数表示已手动排序（-1 最靠前，-2 次之...）
model EntryTagSort {
  entryId   String
  tagId     String
  sortOrder Int      @default(0)

  entry     Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([entryId, tagId])
  @@index([tagId, sortOrder])
}

model Share {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique @default(cuid())
  expiresAt DateTime
  scope     String    @default("all")
  tagIds    String[]  @default([])
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiInsight {
  id           String   @id @default(cuid())
  userId       String
  content      String
  triggerCount Int
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model InsightReport {
  id          String   @id @default(cuid())
  userId      String
  type        String
  periodStart DateTime
  periodEnd   DateTime
  content     Json
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, periodStart])
  @@index([userId, type])
}

model GrowthLog {
  id        String   @id @default(cuid())
  userId    String?
  version   String
  title     String
  content   String
  logDate   DateTime
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  type      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

model MagicLink {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([email])
}

model QuizQuestion {
  id          String   @id @default(cuid())
  entryId     String
  question    String
  type        String
  options     Json
  answer      Json
  explanation String
  angle       Int      @default(1)
  createdAt   DateTime @default(now())

  entry       Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  records     QuizRecord[]

  @@index([entryId])
}

model QuizRecord {
  id            String   @id @default(cuid())
  userId        String
  questionId    String
  entryId       String
  correct       Boolean
  userAnswer    Json?
  answerCount   Int      @default(1)
  answeredAt    DateTime?
  nextReviewAt  DateTime
  streak        Int      @default(0)

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question      QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId, nextReviewAt])
  @@index([userId, questionId])
}

model UserSetting {
  id              String  @id @default(cuid())
  userId          String  @unique
  reviewEnabled   Boolean @default(false)
  lastCardDate    String?
  lastQuestionId  String?

  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReviewCallLog {
  id          String   @id @default(cuid())
  userId      String
  entryId     String?
  step        String   // "pre-generate" | "cache-hit" | "online-retry" | "template-fallback"
  success     Boolean
  questionCount Int    @default(0)
  errorMsg    String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// 心得之间的知识关联（F13）
model EntryLink {
  id           String   @id @default(cuid())
  fromEntryId  String
  toEntryId    String
  relationType String   // sequence(串行) / hierarchy(总分) / related(关联) / insight(启发)
  note         String?  // 可选备注（≤50字）
  source       String   @default("manual") // manual(手动标注) / ai(AI推荐确认)
  createdAt    DateTime @default(now())

  fromEntry    Entry    @relation("EntryLinkFrom", fields: [fromEntryId], references: [id], onDelete: Cascade)
  toEntry      Entry    @relation("EntryLinkTo", fields: [toEntryId], references: [id], onDelete: Cascade)

  @@unique([fromEntryId, toEntryId])
  @@index([fromEntryId])
  @@index([toEntryId])
}

// ============================================================
// ===== 豆苗学习助手模块（独立模块，删除豆苗时移除本区块）=====
// ============================================================

// 豆苗配置（每用户一条）
model AssistantProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  tone       String   @default("温暖鼓励")
  teach      String   @default("启发引导")
  call       String   @default("我 / 你")
  freeDesc   String   @default("")
  wizardDone Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 对话消息（单一持续会话，最近 30 轮参与生成，历史永久保存可翻看）
model AssistantMessage {
  id           String   @id @default(cuid())
  userId       String
  role         String   // "user" | "assistant"
  content      String
  retrievedTag String?  // 如「标签匹配：React（3篇）」，非知识问答为 null
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

// 记忆条目（兴趣与薄弱点，选择性写入，可见可删）
model AssistantMemory {
  id          String   @id @default(cuid())
  userId      String
  type        String   // "interest" | "weak"
  title       String   // 主题（如 CSS 布局）
  description String   // 一句话描述
  source      String   // "dialogue" | "quiz" | "user_specified"
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// DeepSeek 调用消耗记录（成本追溯审计）
model AssistantUsage {
  id            String   @id @default(cuid())
  userId        String
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  model         String   @default("deepseek-chat")
  estimatedCost Float    @default(0) // 估算费用（元）
  questionBrief String?  // 用户问题摘要（≤30字，脱敏概览用）
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}